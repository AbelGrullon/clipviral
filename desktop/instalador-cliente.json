{
  "appId": "com.clipviral.cliente",
  "productName": "ClipViral",
  "artifactName": "ClipViral-Cliente-Setup-${version}.${ext}",
  "extraMetadata": {
    "name": "clipviral-cliente",
    "edicion": "cliente"
  },
  "directories": {
    "output": "dist-cliente"
  },
  "files": [
    "main.js",
    "preload.js",
    "app-config.json",
    "licencia-publica.pem",
    "engine/**",
    "renderer/**",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "ClipViral",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "electronDist": "node_modules/electron/dist",
  "electronVersion": "45.2.2",
  "afterPack": "./scripts/copiar-servidor.js"
}
