{
  "appId": "com.clipviral.app",
  "productName": "ClipViral",
  "artifactName": "ClipViral-Setup-${version}.${ext}",
  "directories": {
    "output": "dist-instalador"
  },
  "files": [
    "main.js",
    "preload.js",
    "app-config.json",
    "licencia-publica.pem",
    "engine/**",
    "renderer/**",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "shortcutName": "ClipViral",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "electronDist": "node_modules/electron/dist",
  "electronVersion": "45.2.2"
}
