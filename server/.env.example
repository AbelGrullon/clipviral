# "Iniciar ClipViral.bat" crea el .env desde este archivo la primera vez. No hace falta tocarlo.

# Puerto del servidor
PORT=4600

# Clave de Claude: lo normal es ponerla en la app (Ajustes → Clave de Claude), en el panel de admin
# o en el asistente del .bat; ahí se guarda cifrada. Si la pones aquí, se usa solo cuando no hay
# ninguna guardada (de respaldo). Se consigue en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Clave para cifrar los tokens de redes y la clave de Claude. Si no la pones, se crea sola en data/secret.key
# (no la pierdas: sin ella habría que volver a conectar las redes y a poner la clave de Claude).
# SECRET_KEY=

# Carpeta donde se guardan la base de datos y los instaladores subidos (opcional)
# DATA_DIR=./data

# Cuenta de prueba para desarrollo local (créala con: npm run crear-admin -- <correo> <contraseña>)
# PRUEBA_ADMIN_CORREO=admin@clipviral.test
# PRUEBA_ADMIN_CLAVE=ClipViral-Prueba-2026
