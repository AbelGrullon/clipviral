{
  "name": "clipviral-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de ClipViral: cuentas, planes, IA con Claude y actualizaciones",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "crear-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/crear-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13"
  }
}
